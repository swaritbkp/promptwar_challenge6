# Copy to .env for local runs. The app runs fully WITHOUT any keys (fixture + deterministic fallback mode).
APP_ENV=dev
PORT=8080
LOG_LEVEL=INFO

# Google
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
LLM_TIMEOUT_S=15
AQ_TIMEOUT_S=4

# Caching (bounded). Set REDIS_URL to use Redis/Memorystore instead of in-memory TTL-LRU.
REDIS_URL=
# Observability / proxy trust. GCP_PROJECT_ID enables Cloud Logging trace correlation.
GCP_PROJECT_ID=
# Optional bearer token for GET /metrics (empty = open; set it on any shared deployment).
METRICS_AUTH_TOKEN=
# Proxies that append to X-Forwarded-For (Cloud Run GFE = 1; 0 = trust only the socket peer).
TRUSTED_PROXY_HOPS=1
CACHE_MAX_ENTRIES=2048
AQ_CACHE_TTL_S=1800

# Sessions (bounded)
SESSION_MAX=1000
SESSION_TTL_S=3600
SESSION_MAX_TURNS=20
# Prompt memory per chat turn (newest turns first, oldest pruned to fit the char budget)
CHAT_HISTORY_TURNS=8
CHAT_HISTORY_MAX_CHARS=6000

# Limits
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_MAX_CLIENTS=5000
MAX_BODY_BYTES=65536
CHAT_MAX_CHARS=1000
# Per-client caps on Gemini-backed features (chat, narration)
AI_LIMIT_PER_MIN=6
AI_LIMIT_PER_DAY=60

# Engine
MONTE_CARLO_SAMPLES=200
MONTE_CARLO_SEED=42
PLANNER_ROBUST_LAMBDA=0.5
FORECAST_SHIFT_REPLAN_THRESHOLD_UG_M3=40

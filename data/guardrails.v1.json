{"version": "v1", "injection_patterns": [{"id": "inj_ignore", "regex": "(?i)\\b(ignore|disregard|forget)\\b.{0,30}\\b(previous|prior|above|all|earlier)\\b.{0,20}\\b(instructions?|rules?|prompts?)\\b"}, {"id": "inj_system", "regex": "(?i)\\b(system|developer)\\s*(prompt|message|instructions?)\\b"}, {"id": "inj_roleplay", "regex": "(?i)\\byou\\s+are\\s+now\\b|\\bact\\s+as\\b.{0,20}\\b(unfiltered|jailbroken|dan)\\b|\\bdeveloper\\s+mode\\b"}, {"id": "inj_reveal", "regex": "(?i)\\b(reveal|print|show|repeat)\\b.{0,30}\\b(prompt|instructions|secret|api\\s*key|canary)\\b"}, {"id": "inj_role_tags", "regex": "(?i)<\\s*/?\\s*(system|assistant|instructions?)\\s*>|\\[\\s*(system|inst)\\s*\\]"}, {"id": "inj_base64_blob", "regex": "[A-Za-z0-9+/]{120,}={0,2}"}, {"id": "inj_hi_ignore", "regex": "(पिछले|सभी)\\s*(निर्देश|नियम).{0,15}(भूल|अनदेखा|नज़रअंदाज़)"}], "pii_patterns": [{"id": "pii_phone_in", "regex": "(?<!\\d)(?:\\+91[\\s-]?)?[6-9]\\d{9}(?!\\d)", "mask": "[PHONE]"}, {"id": "pii_email", "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "mask": "[EMAIL]"}, {"id": "pii_aadhaar_like", "regex": "(?<!\\d)\\d{4}\\s?\\d{4}\\s?\\d{4}(?!\\d)", "mask": "[ID]"}, {"id": "pii_pan_like", "regex": "\\b[A-Z]{5}\\d{4}[A-Z]\\b", "mask": "[PAN]"}], "health_red_flags": {"en": ["can't breathe", "cannot breathe", "breathless at rest", "struggling to breathe", "chest pain", "blue lips", "bluish lips", "fainted", "fainting", "confused", "unconscious", "wheezing badly"], "hi": ["साँस नहीं", "सांस नहीं ले", "साँस लेने में बहुत तकलीफ", "सीने में दर्द", "होंठ नीले", "बेहोश", "चक्कर आकर गिर"]}, "output_blocklist_patterns": [{"id": "diag", "regex": "(?i)\\byou (have|are suffering from)\\s+(asthma|copd|bronchitis|pneumonia|an? infection)\\b"}, {"id": "dosing", "regex": "(?i)\\btake\\s+\\d+\\s*(mg|ml|puffs?|tablets?)\\b"}, {"id": "medical_dosing_advice", "regex": "(?i)\\b(take\\s+\\d+\\s*(mg|ml|puffs?|tablets?)|\\d+\\s*mg/kg|inhaler\\s+dose|nebulizer\\s+dose|steroid\\s+dose|puffs?\\s+per\\s+(day|dose))\\b"}], "medical_dosing_patterns": [{"id": "dose_puffs", "regex": "(?i)\\bhow many puffs?\\b"}, {"id": "dose_mg_kg", "regex": "(?i)\\bmg/kg\\b"}, {"id": "dose_prescribe", "regex": "(?i)\\b(prescribe|prescription)\\b.{0,30}\\b(inhaler|dose|medication|steroid|nebulizer)\\b"}, {"id": "dose_steroid", "regex": "(?i)\\b(steroid|nebulizer|corticosteroid)\\s+(dose|dosage)\\b"}, {"id": "dose_child_meds", "regex": "(?i)\\b(inhaler|medication|medicine)\\s+(dose|dosage)\\b|\\bwhat (inhaler )?dose should\\b"}, {"id": "dose_hi", "regex": "(दवा|खुराक|इनहेलर|डोज).{0,25}(लेनी|देनी|चाहिए|बताओ)"}, {"id": "dose_named_drug", "regex": "(?i)\\b(salbutamol|albuterol|asthalin|levolin|levosalbutamol|budesonide|budecort|foracort|seroflo|formoterol|montelukast|prednisolone|deriphyllin|paracetamol|ibuprofen|cough syrup)\\b.{0,40}\\b(dose|dosage|puffs?|mg|ml|how much|how many|kitna|kitni|give|take)\\b|\\b(dose|dosage|puffs?|how much|how many)\\b.{0,40}\\b(salbutamol|albuterol|asthalin|levolin|levosalbutamol|budesonide|budecort|foracort|seroflo|formoterol|montelukast|prednisolone|deriphyllin|paracetamol|ibuprofen|cough syrup)\\b"}, {"id": "dose_how_much_med", "regex": "(?i)\\bhow (much|many)\\b.{0,30}\\b(inhaler|puffs?|medicine|medication|syrup|tablets?|nebuli[sz]er|steroids?)\\b"}, {"id": "dose_hi_puffs", "regex": "कितने\\s*(पफ|कश)|कितनी\\s*(खुराक|गोली|दवा)"}]}